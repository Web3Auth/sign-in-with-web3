{
  "include": ["src", "vite.config.mts"],
  "exclude": ["node_modules", "src/**/*.test.tsx", "src/setupTests.ts"],
  "compilerOptions": {
    "noEmit": true,
    "target": "esnext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  }
}
