{
  "name": "react-app",
  "version": "0.9.3",
  "author": "Web3Auth",
  "repository": "https://github.com/Web3Auth/sign-in-with-ethereum",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "public",
    "index.html",
    "vite.config.mts",
    ".eslintignore",
    ".prettierignore",
    "package.json",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "vite build",
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --write '{*,**/*}.{js,ts,jsx,tsx,json}'",
    "lint": "oxlint src vite.config.mts && prettier --check '{*,**/*}.{js,ts,jsx,tsx,json}'",
    "lint:fix": "oxlint src vite.config.mts --fix && npm run fmt",
    "nuke": "shx rm -rf node_modules package.lock"
  },
  "dependencies": {
    "@web3auth/sign-in-with-web3": "file:../../",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "sweetalert2": "^11.4.12",
    "viem": "^2.57.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "^17.0.40",
    "@types/react-dom": "^17.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.91.0",
    "prettier": "^2.5.1",
    "shx": "^0.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
