{
  "name": "react-app",
  "version": "0.9.3",
  "author": "Web3Auth",
  "repository": "https://github.com/Web3Auth/sign-in-with-ethereum",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "public",
    "index.html",
    "vite.config.mts",
    ".eslintignore",
    ".eslintrc",
    ".prettierignore",
    "package.json",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "vite build",
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --write '{*,**/*}.{js,ts,jsx,tsx,json}'",
    "lint": "oxlint src vite.config.mts && prettier --check '{*,**/*}.{js,ts,jsx,tsx,json}'",
    "lint:fix": "oxlint src vite.config.mts --fix && npm run fmt",
    "nuke": "shx rm -rf node_modules package.lock"
  },
  "dependencies": {
    "@babel/runtime": "^7.18.3",
    "@web3auth/sign-in-with-web3": "file:../../",
    "query-string": "^7.1.1",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "sweetalert2": "^11.4.12",
    "url": "^0.11.0",
    "web3": "^1.7.3"
  },
  "devDependencies": {
    "@types/eslint": "^8.2.2",
    "@types/eslint-plugin-prettier": "^3.1.0",
    "@types/node": "^22.12.0",
    "@types/prettier": "^2.4.3",
    "@types/react": "^17.0.40",
    "@types/react-dom": "^17.0.0",
    "@typescript-eslint/eslint-plugin": "^5.14.0",
    "@typescript-eslint/parser": "^5.14.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^8.11.0",
    "oxlint": "^1.91.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.29.3",
    "eslint-plugin-react-hooks": "^4.3.0",
    "prettier": "^2.5.1",
    "shx": "^0.3.4",
    "tslib": "^2.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
